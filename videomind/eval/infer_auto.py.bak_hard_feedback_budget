@contextmanager
def resolve_infer_context(context, model, where="infer_auto"):
    cm = None
    entered = False
    try:
        cm = context()
        cm.__enter__()
        entered = True
    except Exception as e:
        print(f"[WARN] context enter failed in {where}: {type(e).__name__}: {e}; fallback to current adapters")
    try:
        yield
    finally:
        if entered and cm is not None:
            try:
                cm.__exit__(None, None, None)
            except Exception as e:
                print(f"[WARN] context exit failed in {where}: {type(e).__name__}: {e}")


