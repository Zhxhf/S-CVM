def evaluate_candidate(model, processor, video_path: str, question: str, options: Optional[Sequence[str]],
                       anno: Dict, candidate: Dict[str, Any], dataset_cls, args, device: str,
                       answerer_adapter_enabled: bool) -> Dict[str, Any]:
    segments = candidate['segments']
    response = run_answerer(model, processor, video_path, question, options, anno, segments,
                            dataset_cls, args, device,
                            use_answerer_adapter=answerer_adapter_enabled)
    print(response)
    answer_text = resolve_answer_text(response, options)

    reverse_question = None
    faithfulness_score = None
    verifier_score = candidate.get('verifier_score')
    if candidate.get('need_sufficiency', True):
        if verifier_score is not None and verifier_score >= args.verifier_skip_reverse_threshold:
            faithfulness_score = verifier_score
            print(f'skip_reverse_question verifier_score={verifier_score:.4f}')
        else:
            reverse_question = run_reverse_question(
                model, processor, video_path, answer_text, segments, dataset_cls, args, device,
                use_answerer_adapter=answerer_adapter_enabled)
            print(reverse_question)
            faithfulness_score = token_f1_overlap(question, reverse_question)
            print(f'faithfulness_score={faithfulness_score:.4f}')

    sufficiency_score = combine_sufficiency_score(
        faithfulness_score, verifier_score, beta=args.sufficiency_beta)

    out = dict(candidate)
    out.update(dict(
        response=response,
        answer_text=answer_text,
        reverse_question=reverse_question,
        faithfulness_score=faithfulness_score,
        overlap=faithfulness_score,
        sufficiency_score=sufficiency_score,
    ))
    return out


def build_candidate_pool(pred: Sequence[Sequence[float]], conf: Sequence[float], verifier_scores: Sequence[float],
                         duration: float, dataset_cls, args) -> List[Dict[str, Any]]:
    k = max(1, min(args.candidate_pool_size, len(pred)))
    unit = getattr(dataset_cls, 'UNIT', 0.001)
    if hasattr(dataset_cls, 'MIN_RATIO'):
        min_len = duration * dataset_cls.MIN_RATIO
    else:
        min_len = getattr(dataset_cls, 'MIN_LEN', 32)

    grounder_norm = minmax_normalize(conf[:k])
    verifier_norm = minmax_normalize(verifier_scores[:k])
    pool = []
    for idx in range(k):
        s, e = parse_span(pred[idx], duration, min_len)
        seg = round_span([s, e], unit)
        init_score = combine_candidate_score(
            grounder_norm[idx] if idx < len(grounder_norm) else 0.5,
            verifier_norm[idx] if idx < len(verifier_norm) else 0.5,
            alpha=args.score_alpha)
        pool.append(dict(
            id=f'single_{idx}',
            kind='single',
            source_index=idx,
            segments=[seg],
            verifier_score=verifier_norm[idx] if idx < len(verifier_norm) else None,
            grounder_score=grounder_norm[idx] if idx < len(grounder_norm) else None,
            init_score=init_score,
            history=[],
            need_sufficiency=True,
        ))
    return pool


def _candidate_history_set(candidate: Dict[str, Any]) -> set:
    history = candidate.get('history', []) or []
    return {str(x) for x in history}


def plan_feedback_action(question: str,
                         evaluated: Dict[str, Any],
                         feedback_label: Optional[str],
                         active_cfg: Dict[str, Any]) -> Tuple[str, str]:
    label = feedback_label or 'uncertain'
    direction = infer_temporal_preference(question, evaluated.get('reverse_question'), label)
    if label in {'reason'}:
        return 'merge-2' if active_cfg.get('use_merge_two_segments', False) else 'expand', 'left'
    if label in {'result'}:
        return 'merge-2' if active_cfg.get('use_merge_two_segments', False) else 'expand', 'right'
    if label in {'temporal_order', 'dialogue'}:
        return ('merge-2' if active_cfg.get('use_merge_two_segments', False) else 'expand', direction)
    if label in {'subject', 'action'}:
        return ('switch' if active_cfg.get('use_candidate_switch', False) else 'expand', direction)
    return 'expand', direction


def pick_switch_candidate(pool: Sequence[Dict[str, Any]],
                          current_candidate: Dict[str, Any],
                          args) -> Optional[Dict[str, Any]]:
    current_id = current_candidate['id']
    current_seg = current_candidate['segments'][0] if current_candidate.get('segments') else None
    visited = _candidate_history_set(current_candidate) | {current_id}
    choices = []
    for cand in pool:
        if cand['kind'] != 'single' or cand['id'] == current_id or cand['id'] in visited:
            continue
        utility = float(cand.get('init_score', 0.0))
        if current_seg is not None:
            utility += args.switch_diversity_weight * segment_diversity(current_seg, cand['segments'][0])
        if cand.get('source_index') == current_candidate.get('source_index'):
            utility -= args.switch_penalty_same_source
        choices.append((utility, cand))
    if not choices:
        for cand in pool:
            if cand['kind'] != 'single' or cand['id'] == current_id:
                continue
            utility = float(cand.get('init_score', 0.0))
            if current_seg is not None:
                utility += 0.5 * args.switch_diversity_weight * segment_diversity(current_seg, cand['segments'][0])
            choices.append((utility, cand))
    if not choices:
        return None
    _, best = sorted(choices, key=lambda x: x[0], reverse=True)[0]
    switched = copy.deepcopy(best)
    switched['history'] = list(visited)
    return switched


def pick_merge_candidate(pool: Sequence[Dict[str, Any]], current_candidate: Dict[str, Any], args) -> Optional[Dict[str, Any]]:
    if current_candidate['kind'] != 'single':
        return None
    current_seg = current_candidate['segments'][0]
    visited = _candidate_history_set(current_candidate) | {current_candidate['id']}
    choices = []
    for cand in pool:
        if cand['kind'] != 'single' or cand['id'] == current_candidate['id'] or cand['id'] in visited:
            continue
        seg = cand['segments'][0]
        utility = float(cand.get('init_score', 0.0)) + args.pair_diversity_weight * segment_diversity(current_seg, seg)
        choices.append((utility, cand))
    if not choices:
        return None
    best_utility, second = sorted(choices, key=lambda x: x[0], reverse=True)[0]
    if best_utility < float(current_candidate.get('init_score', 0.0)) + args.pair_score_margin:
        return None
    merged_id = f"pair_{current_candidate['id']}__{second['id']}"
    verifier_score = None
    scores = [x.get('verifier_score') for x in (current_candidate, second) if x.get('verifier_score') is not None]
    if scores:
        verifier_score = sum(scores) / len(scores)
    return dict(
        id=merged_id,
        kind='pair',
        source_index=(current_candidate['source_index'], second['source_index']),
        segments=[list(current_candidate['segments'][0]), list(second['segments'][0])],
        verifier_score=verifier_score,
        grounder_score=max(current_candidate.get('grounder_score', 0.0), second.get('grounder_score', 0.0)),
        init_score=max(current_candidate.get('init_score', 0.0), second.get('init_score', 0.0)),
        need_sufficiency=True,
        parent_ids=[current_candidate['id'], second['id']],
        history=list(visited | {second['id']}),
    )


def apply_expand_action(candidate: Dict[str, Any], duration: float, ratio: float, unit: float,
                        direction: str = 'both', secondary_ratio: Optional[float] = None) -> Dict[str, Any]:
    updated = copy.deepcopy(candidate)
    if updated.get('kind') == 'pair' and secondary_ratio is not None and len(updated.get('segments', [])) > 1:
        segments = []
        for idx, seg in enumerate(updated['segments']):
            seg_ratio = ratio if idx in {0, len(updated['segments']) - 1} else secondary_ratio
            if idx == 0 and direction == 'left':
                seg_dir = 'left'
            elif idx == len(updated['segments']) - 1 and direction == 'right':
                seg_dir = 'right'
            else:
                seg_dir = 'both'
            segments.append(list(expand_segments_directional([seg], duration, seg_ratio, seg_dir)[0]))
        updated['segments'] = round_segments(segments, unit)
    else:
        updated['segments'] = round_segments(
            expand_segments_directional(updated['segments'], duration, ratio, direction), unit)
    updated['history'] = list(_candidate_history_set(candidate) | {candidate['id']})
    return updated


def should_compute_sufficiency(round_idx: int, active_cfg: Dict[str, Any], args) -> bool:
    if not active_cfg.get('use_sufficiency_estimation', False):
        return False
    max_eval_rounds = max(0, int(getattr(args, 'sufficiency_eval_rounds', 1)))
    return round_idx <= max_eval_rounds


def _effective_confidence(evaluated: Dict[str, Any]) -> Optional[float]:
    """Return the strongest available confidence signal for feedback gating."""
    vals = []
    for key in ('sufficiency_score', 'faithfulness_score', 'verifier_score'):
        val = evaluated.get(key)
        if val is not None:
            try:
                vals.append(float(val))
            except Exception:
                pass
    return max(vals) if vals else None


def should_accept_candidate(evaluated: Dict[str, Any], active_cfg: Dict[str, Any], args) -> bool:
    if not active_cfg.get('use_faithfulness_acceptance', False):
        return False
    conf = _effective_confidence(evaluated)
    if conf is None:
        return False
    if conf >= args.verifier_accept_threshold:
        return True
    sufficiency_score = evaluated.get('sufficiency_score')
    if sufficiency_score is None:
        return False
    return sufficiency_score >= (args.sufficiency_threshold - args.acceptance_margin)


def sample_feedback_budget_allowed(args, sample_key: str) -> bool:
    """Deterministically cap feedback candidates to the configured budget ratio.

    This is intentionally conservative for high-baseline QA: it prevents almost-all-sample
    feedback runs and keeps the actual feedback rate below the target even when the
    sufficiency estimator is noisy.
    """
    ratio = max(0.0, min(1.0, float(getattr(args, 'feedback_budget_ratio', 0.18))))
    if ratio <= 0:
        return False
    digest = hashlib.md5(str(sample_key).encode('utf-8')).hexdigest()
    bucket = int(digest[:8], 16) / float(0xFFFFFFFF)
    return bucket < ratio


def should_trigger_feedback(evaluated: Dict[str, Any], accepted: bool, round_idx: int, active_cfg: Dict[str, Any], args) -> bool:
    if accepted:
        return False
    if getattr(args, 'force_low_feedback', True) and not evaluated.get('feedback_budget_allowed', False):
        return False
    if round_idx >= active_cfg['max_rounds']:
        return False
    if not active_cfg.get('use_evidence_acquisition', False):
        return False

    conf = _effective_confidence(evaluated)
    sufficiency_score = evaluated.get('sufficiency_score')

    # Extreme low-feedback policy: only budget-allowed and clearly low-confidence
    # samples enter feedback. Borderline samples stop at round 1 to avoid wrong edits.
    if conf is None:
        return False
    if conf >= args.feedback_verifier_floor:
        return False
    if sufficiency_score is None:
        return False
    return sufficiency_score < (args.sufficiency_threshold - args.min_feedback_gap)


def choose_final_round(rounds, selection_rule: str):
    if len(rounds) == 0:
        return None
    if selection_rule == 'last':
        return rounds[-1]
    if selection_rule == 'first_sufficient':
        for round_info in rounds:
            if round_info.get('accepted', False):
                return round_info
        return rounds[-1]
    if selection_rule == 'best_faithfulness':
        valid = [r for r in rounds if r.get('faithfulness_score') is not None]
        if len(valid) == 0:
            return rounds[-1]
        valid = sorted(valid, key=lambda x: ((x.get('sufficiency_score') if x.get('sufficiency_score') is not None else -1),
                                             (x.get('faithfulness_score') if x.get('faithfulness_score') is not None else -1),
                                             -x['round']))
        return valid[-1]
    raise ValueError(f'unsupported selection rule: {selection_rule}')


