                                direction=expand_direction, secondary_ratio=args.expand_secondary_ratio)
                            action = f'expand-{expand_direction}'
                    elif planned_action == 'switch':
                        switched = pick_switch_candidate(pool, evaluated, args)
                        if switched is not None:
                            current_candidate = switched
                            action = f'switch[{expand_direction}]'
                        else:
                            current_candidate = apply_expand_action(
                                evaluated, duration, args.boundary_expand_ratio, unit,
                                direction=expand_direction, secondary_ratio=args.expand_secondary_ratio)
                            action = f'expand-{expand_direction}'
                    else:
                        current_candidate = apply_expand_action(
                            evaluated, duration, args.boundary_expand_ratio, unit,
                            direction=expand_direction, secondary_ratio=args.expand_secondary_ratio)
