def activate_role(model, role):
    """Switch between base model and loaded PEFT adapters.

    Assumption for the current checkpoint:
    - grounder / answerer -> use base model weights (no adapter)
    - planner / verifier  -> use loaded adapters
    """
    base = getattr(model, "base_model", None)

    # try to infer loaded adapter names
    available = set()
    if hasattr(model, "peft_config") and model.peft_config is not None:
        try:
            available.update(model.peft_config.keys())
        except Exception:
            pass
    if base is not None and hasattr(base, "peft_config") and base.peft_config is not None:
        try:
            available.update(base.peft_config.keys())
        except Exception:
            pass

    # roles that should fall back to base model
    if role in {"grounder", "answerer"} and role not in available:
        if hasattr(model, "disable_adapters"):
            model.disable_adapters()
            return
        if base is not None and hasattr(base, "disable_adapters"):
            base.disable_adapters()
            return
        return

    # preferred modern API
    if hasattr(model, "set_adapter"):
        model.set_adapter(role)
        return
    if base is not None and hasattr(base, "set_adapter"):
        base.set_adapter(role)
        return

    raise AttributeError(
        f"Cannot activate role={role!r}; available adapters={sorted(available) if available else 'unknown'}"
    )
def decode_generation(model, processor, data, max_new_tokens: int = 256) -> str:
    output_ids = model.generate(
        **data,
        do_sample=False,
        temperature=None,
        top_p=None,
        top_k=None,
        repetition_penalty=None,
        max_new_tokens=max_new_tokens)
    assert data.input_ids.size(0) == output_ids.size(0) == 1
    output_ids = output_ids[0, data.input_ids.size(1):]
    if len(output_ids) > 0 and output_ids[-1] == processor.tokenizer.eos_token_id:
        output_ids = output_ids[:-1]
    return processor.decode(output_ids, clean_up_tokenization_spaces=False)



def build_answer_prompt(question: str, options: Optional[Sequence[str]], style: str) -> str:
    if options is None:
        return question
    if style in ('mcq', 'options'):
        prompt = question + '\nOptions:'
        for idx, opt in enumerate(options):
            opt = str(opt)
            prompt += f"\n({chr(ord('A') + idx)}) {opt[0].upper() + opt[1:]}"
        prompt += '\nPlease only give the best option.'
        return prompt
    return question



def maybe_add_subtitles(prompt: str, anno: Dict, seg: Tuple[float, float], use_subtitle: bool) -> str:
    if not use_subtitle or 'subtitle_path' not in anno or not nncore.is_file(anno['subtitle_path']):
        return prompt
    s, e = seg
    subs = load_subtitle(anno['subtitle_path'])
    subs = [f'{round(a - s, 1)}s - {round(b - s, 1)}s, {t}\n' for a, b, t in subs if a >= s and b <= e]
    subs = ''.join(subs[:100])
    return f'You are given a video with {round(e - s, 1)} seconds long.\nSubtitles:\n{subs}' + prompt



