                    faithfulness_score=faithfulness_score,
                    overlap=faithfulness_score,
                    accepted=accepted,
                    action='stop' if accepted else ('expand-both' if active_cfg['use_evidence_acquisition'] and round_idx < active_cfg['max_rounds'] else None),
                )
                rounds.append(round_info)

                if accepted:
                    print(f'Round {round_idx} accepted')
                    break
                if round_idx >= active_cfg['max_rounds']:
                    break
                if not active_cfg['use_evidence_acquisition']:
                    break

                current_seg = expand_span(current_seg, duration, args.boundary_expand_ratio)
                current_seg = tuple(round_span(current_seg, unit))
                print(f'Expanded evidence state for next round: {current_seg}')

            final_round = choose_final_round(rounds, active_cfg['selection_rule'])
            dump['evidence_rounds'] = rounds if args.save_round_details or True else None
            dump['feedback_rounds'] = dump['evidence_rounds']  # backward-compatible alias
            dump['executed_rounds'] = len(rounds)
            dump['accepted_round'] = accepted_round
            dump['selected_round'] = final_round['round'] if final_round is not None else None
            dump['selected_span'] = final_round['span'] if final_round is not None else None
            dump['selected_evidence_state'] = final_round['evidence_state'] if final_round is not None else None
            dump['final_answer_text'] = final_round['answer_text'] if final_round is not None else ''
            dump['response'] = final_round['response'] if final_round is not None else ''
            dump['answerer_response'] = dump['response']
            dump['reverse_question'] = final_round['reverse_question'] if final_round is not None else None
            dump['faithfulness_score'] = final_round['faithfulness_score'] if final_round is not None else None
            dump['overlap'] = dump['faithfulness_score']
            dump['evidence_sufficient'] = accepted_round is not None
        dumps.append(dump)

    nncore.dump(dumps, pred_path)
