@contextmanager
def safe_disable_adapter(model):
    """
    Avoid peft.PeftModel.disable_adapter() -> get_model_status() path,
    which crashes in the current environment. Directly toggle adapter
    layers on the wrapped base model instead.
    """
    base_model = getattr(model, "base_model", None)
    disabled = False
    try:
        if base_model is not None and hasattr(base_model, "disable_adapter_layers"):
            base_model.disable_adapter_layers()
            if hasattr(model, "_adapters_disabled"):
                model._adapters_disabled = True
            disabled = True
        yield
    finally:
        if disabled and hasattr(base_model, "enable_adapter_layers"):
            base_model.enable_adapter_layers()
            if hasattr(model, "_adapters_disabled"):
                model._adapters_disabled = False


def resolve_infer_context(context, model):
    name = getattr(context, "__name__", "")
    qualname = getattr(context, "__qualname__", "")
    if name == "disable_adapter" or "disable_adapter" in qualname:
        return safe_disable_adapter(model)
    return context()

